# Light sensor rig: broker settings for rig.py, session.py, logger.py and pi_agent.py.
# Lives at ~/.config/light-polluter/rig.env, readable only by you (chmod 600).
# The web app's Setup page shows the values to put here.

# The cloud broker. For the laptop broker instead, put the laptop's IP address here
# and leave the username and password empty.
RIG_BROKER=wss://BROKER-DOMAIN
RIG_MQTT_USERNAME=pi
RIG_MQTT_PASSWORD=
